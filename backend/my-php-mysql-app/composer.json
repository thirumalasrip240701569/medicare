{
    "name": "my-php-mysql-app",
    "description": "A PHP application with MySQL database integration.",
    "type": "project",
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-mysqli": "*",
        "vlucas/phpdotenv": "^5.4",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.3",
        "monolog/monolog": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}